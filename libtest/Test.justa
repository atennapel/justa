module Test

pub def vtype = type val
pub def ctype = type comp

pub def id {A} (x : A) = x
pub def const {A B : meta} (x y : A) = x

pub def not b = if b then False else True
pub def (&&) a b = if a then b else False
pub def (||) a b = if a then True else b

pub def cond {k} {A : type k} (a b : A) (c : Bool) : A =
  if c then a else b

pub def (<) a b = lt a b
pub def (+) a b = add a b
pub def (*) a b = mul a b
pub def (-) a b = sub a b

pub def factorial (n : Int) :=
  let rec go (n : Int) (acc : Int) :=
    if n < 2 then acc
    else go (n - 1) (acc * n);
  go n 1

def evenodd : [even : Int -> Bool, odd : Int -> Bool] :=
  let rec go : [even : Int -> Bool, odd : Int -> Bool] :=
    [
      \n => if n < 1 then True else go.odd (n - 1),
      \n => if n < 1 then False else go.even (n - 1)
    ];
  go

def even := evenodd.even

def fff := 42

def evenodd2 : [even : Int -> Bool, odd : Int -> Bool] :=
  let f (x : Bool) := x;
  let rec go : [even : Int -> Bool, odd : Int -> Bool] :=
    [
      \n => if n < 1 then True else f (go.odd (n - 1)),
      \n => if n < 1 then False else f (go.even (n - 1))
    ];
  go

def even2 := evenodd2.even

data Option A := None | Some A

def testoption (x : Option Int) := x
def testoption2 := Some 42

def testoption3 :=
  match testoption2
  | Some x => x
  | None => 0

def testoption4 : Option Int := None

def testoption5 :=
  match testoption2
  | None => True
  | _ => False
