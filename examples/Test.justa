module Test

import Prelude (imul => mul, isub => sub)

pub def fac (n : Int) :=
  let rec go (n : Int) : Int :=
    instr ifeq n
      1
      (mul n (go (sub n 1)));
  go n

pub def facTR (n : Int) :=
  let rec go (n acc : Int) : Int :=
    instr ifeq n
      acc
      (go (sub n 1) (mul n acc));
  go n 1

def a (x : Array Int) := x
