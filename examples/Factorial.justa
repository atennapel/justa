module Factorial

import Prelude (izero => isZero, imul => mul, isub => sub)

pub def fac : Int -> Int = \n =>
  let rec go : Int -> Int = \n =>
    if isZero n then
      1
    else
      mul n (go (sub n 1));
  go n

pub def facTR : Int -> Int = \n =>
  let rec go : Int -> Int -> Int = \n =>
    if isZero n then
      \acc => acc
    else
      \acc => go (sub n 1) (mul n acc);
  go n 1
