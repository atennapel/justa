(module Factorial (Prelude))

(def fac (-> Int Int) (fn n
  (letrec go (-> Int Int) (fn n
    (if (Prelude.izero n)
      1
      (Prelude.imul n (go (Prelude.isub n 1)))))
    (go n))))

(def facTR (-> Int Int) (fn n
  (letrec go (-> Int Int Int) (fn n
    (if (Prelude.izero n)
      (fn acc acc)
      (fn acc (go (Prelude.isub n 1) (Prelude.imul n acc)))))
    (go n 1))))
