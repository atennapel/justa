module Factorial

import Prelude

def fac : Int -> Int = \n =>
  let rec go : Int -> Int = \n =>
    if Prelude.izero n then
      1
    else
      Prelude.imul n (go (Prelude.isub n 1));
  go n

def facTR : Int -> Int = \n =>
  let rec go : Int -> Int -> Int = \n =>
    if Prelude.izero n then
      \acc => acc
    else
      \acc => go (Prelude.isub n 1) (Prelude.imul n acc);
  go n 1
