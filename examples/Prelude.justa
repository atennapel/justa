module Prelude

import Primitives (Int)

pub def vtype = type val
pub def ctype = type comp

pub finite Void
pub finite Unit = MkUnit
pub finite Bool = False | True

pub def not (b : Bool) = if b then False else True

pub def iadd (a b : Int) : Int = instr 96 a b
pub def iinc (n : Int) = iadd n 1
pub def imul (a b : Int) : Int = instr 104 a b
pub def isub (a b : Int) : Int = instr 100 a b
pub def idec (n : Int) = isub n 1
pub def inonzero (n : Int) : Bool = instr id n
pub def izero (n : Int) : Bool = not (inonzero n)

pub data Maybe A = Nothing | Just A

def test := Just {Int} 42

def mapMaybe {A B : vtype} (f : A -> B) (m : Maybe A) : Maybe B =
  match m {
  | Just n => Just {B} (f n)
  | Nothing => Nothing {B}
  }

-- def idMaybeInt (m : Maybe Int) := mapMaybe {Int} {Int} (\x => x) m
