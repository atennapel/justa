module Prelude

pub finite Void
pub finite Unit = Unit

pub finite Bool = False | True

pub def True : Bool = fin True
pub def False : Bool = fin False

pub data IntList = Nil | Cons (hd : Int) (tl : IntList)
pub data IntOption = None | Some Int

pub def head : IntList -> IntOption = \l =>
  match l {
    case Cons hd _ => con Some hd
    case Nil => con None
  }

pub def iadd : Int -> Int -> Int = \a b => instr 96 a b

pub def incList : IntList -> IntList = \l =>
  let rec go : IntList -> IntList = \l =>
    match l {
      case Cons hd tl => con Cons (iadd hd 1) (go tl)
      case Nil => con Nil
    };
  go l

pub def imul : Int -> Int -> Int = \a b => instr 104 a b
pub def isub : Int -> Int -> Int = \a b => instr 100 a b
pub def izero : Int -> Bool = \n => instr ifeq n True False
