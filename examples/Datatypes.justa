module Datatypes

import Primitives (Int)
import Prelude (vtype, iinc)

-- testing datatypes
data Option A = None | Some A
def test := Some {Int} 42

def mapOption {A B : vtype} (f : A -> B) (o : Option A) : Option B =
  match o {
  | Some x => Some {B} (f x)
  | None => None {B}
  }

def incIntOption (o : Option Int) := mapOption {Int} {Int} iinc o

data List A = Nil | Cons (head : A) (tail : List A)

def test2 := Cons {Int} 1 (Cons {Int} 2 (Cons {Int} 3 ()))

def mapList {A B : vtype} (f : A -> B) (l : List A) : List B =
  let rec go (l : List A) : List B :=
    match l {
    | Cons hd tl => Cons {B} (f hd) (go tl)
    | Nil => Nil {B}
    };
  go l

def incIntList (l : List Int) := mapList {Int} {Int} iinc l

def reverseList {A : vtype} (l : List A) : List A =
  let rec go (l acc : List A) : List A :=
    match l {
    | Cons hd tl => go tl (Cons {A} hd acc)
    | Nil => acc
    };
  go l (Nil {A})

def reverseIntList (l : List Int) := reverseList {Int} l

record Person = MkPerson (age : Int) (height : Int)
def person := MkPerson 33 195
def age (p : Person) := match p { MkPerson age _ => age }
