module Records

def NatSig = [Nat : meta, Z : Nat, S : Nat -> Nat]

def NatM : NatSig = [
  Nat = (A : meta) -> A -> (A -> A) -> A,
  Z = \A z s => z,
  S = \n A z s => s (n A z s)
]

def Nat = NatM.Nat
def Z : Nat = NatM.Z
def S : Nat -> Nat = NatM.S

def one = S Z

def test := [x := 1, y := 2]

def test2 := test.x
