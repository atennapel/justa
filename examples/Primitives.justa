module Primitives

pub primitive Byte : type val
pub primitive Char : type val
pub primitive Short : type val
pub primitive Int : type val
pub primitive Long : type val
pub primitive Float : type val
pub primitive Double : type val

pub primitive Array : type val -> type val

pub primitive IO : type val -> type comp
pub primitive returnIO {A : type val} (x : A) : IO A
pub primitive bindIO {A B : type val} (action : IO A) (k : ^(A -> IO B)) : IO B
