module TestIO

import Prelude (Unit)
import Factorial (facTR => factorial)

def start : IO Int =
  returnIO (factorial 10)

def print : Int -> IO Unit = \n =>
  let stdout : &java.io.PrintStream = instr getstatic/java.lang.System.out;
  let println : &void = instr invokevirtual/println stdout n;
  let printlnFalse : IO Unit = instr 3 println;
  bindIO x = printlnFalse;
  returnIO x

pub def main : [&java.lang.String] -> IO &void = \arg =>
  bindIO value = start;
  bindIO action = print value;
  let action: &void = instr 87 action;
  instr 177 action
