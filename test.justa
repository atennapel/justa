def vtype = type val

def id {A : meta} (x : A) = x

def n := id 42

def addtest := add 1 2
def iftest := if true then 1 else 2

def fac (n : int) :=
  let rec go (n : int) (acc : int) :=
    if lt n 2 then acc
    else go (sub n 1) (mul acc n);
  go n 1

def condloopacc {Acc : vtype} {Arg : vtype}
  (init : Acc)
  (cond : Acc -> Arg -> bool)
  (argChange : Acc -> Arg -> Arg)
  (accChange : Acc -> Arg -> Acc) : Arg -> Acc =
  \arg =>
    let rec go (acc : Acc) (arg : Arg) :=
      if cond acc arg then acc
      else go (accChange acc arg) (argChange acc arg);
    go init arg 

def fac2 := condloopacc 1 (\_ n => lt n 2) (\_ n => sub n 1) (\acc n => mul acc n)

def fac3 (n : int) :=
  let rec go (n : int) :=
    if lt n 2 then \acc => acc
    else \acc => go (sub n 1) (mul acc n);
  go n 1

def fac4 := fac2

data List A := Nil | Cons (head : A) (tail : List A)

def myList := Cons 1 (Cons 2 (Cons 3 Nil))

def map {A B : vtype} (f : A -> B) (l : List A) : List B =
  let rec go (l : List A) : List B :=
    match l
    | Nil => Nil
    | Cons hd tl => Cons (f hd) (go tl);
  go l

def myList2 := map (add 1) myList

def reverse {A : vtype} (l : List A) : List A =
  let rec go (l : List A) (acc : List A) :=
    match l
    | Nil => acc
    | Cons hd tl => go tl (Cons hd acc);
  go l Nil

def myList3 := reverse myList
