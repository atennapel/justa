module test

def vtype = type val
def ctype = type comp

def id {A : meta} (x : A) = x

def n := id 42

def (<) a b = lt a b
def (+) a b = add a b
def (*) a b = mul a b
def (-) a b = sub a b

def addtest := 1 + 2
def iftest := if True then 1 else 2

def fac (n : Int) :=
  let rec go (n : Int) (acc : Int) :=
    if n < 2 then acc
    else go (n - 1) (acc * n);
  go n 1

def condloopacc {Acc : vtype} {Arg : vtype}
  (init : Acc)
  (cond : Acc -> Arg -> Bool)
  (argChange : Acc -> Arg -> Arg)
  (accChange : Acc -> Arg -> Acc) : Arg -> Acc =
  \arg =>
    let rec go (acc : Acc) (arg : Arg) :=
      if cond acc arg then acc
      else go (accChange acc arg) (argChange acc arg);
    go init arg

def fac2 := condloopacc 1 (\_ n => n < 2) (\_ n => n - 1) (\acc n => acc * n)

def fac3 (n : Int) :=
  let rec go (n : Int) :=
    if n < 2 then \acc => acc
    else \acc => go (n - 1) (acc * n);
  go n 1

def fac4 := fac2

data List A := Nil | Cons (head : A) (tail : List A)

def myList := Cons 1 (Cons 2 (Cons 3 Nil))

def map {A B : vtype} (f : A -> B) (l : List A) : List B =
  let rec go (l : List A) : List B :=
    match l
    | Nil => Nil
    | Cons hd tl => Cons (f hd) (go tl);
  go l

def foldr {A : vtype} {k} {B : type k} (n : B) (c : A -> B -> B) (l : List A) : B =
  let rec go (l : List A) :=
    match l
    | Nil => n
    | Cons hd tl => c hd (go tl);
  go l

def myList2 := map (+ 1) myList

def reverse {A : vtype} (l : List A) : List A =
  let rec go (l : List A) (acc : List A) :=
    match l
    | Nil => acc
    | Cons hd tl => go tl (Cons hd acc);
  go l Nil

def myList3 := reverse myList

-- IO testing
data Pair A B := MkPair A B

def fst {A B : vtype} (p : Pair A B) : A =
  match p | MkPair a b => a

def snd {A B : vtype} (p : Pair A B) : B =
  match p | MkPair a b => b

def randIO : IO Int := returnIO 42

def testProgram : IO (Pair Int Int) :=
  bindIO randIO \a =>
  bindIO randIO \b =>
  returnIO (MkPair a b)

-- lambda match testing
def isEmpty {A : vtype} : ^(List A -> Bool) =
  match
  | Nil => True
  | _ => False

def isEmpty2 {A : vtype} : List A -> Bool =
  match
  | Nil => True
  | _ => False

def isEmptyTest1 := isEmpty myList
def isEmptyTest2 := isEmpty2 myList

-- push testing
def Push A = (k : cv) (B : type k) -> (A -> B -> B) -> B -> B

def nil {A : vtype} : Push A =
  \k B c n => n

def cons {A : vtype} (hd : A) (tl : Push A) : Push A =
  \k B c n => c hd (tl k B c n)

def fromList {A : vtype} (as : List A) : Push A =
  \k B f b => foldr b f as

def toList {A : vtype} (as : Push A) : List A =
  as _ _ Cons Nil

def mapPush {A B : vtype} (f : A -> B) (as : Push A) : Push B =
  \k R c n => as k R (\a bs => c (f a) bs) n

def foldrPush {A : vtype} {k} {B : type k} (b : B) (f : A -> B -> B) (as : Push A) : B =
  as k B f b

def foldlPush {A B : vtype} (b : B) (f : B -> A -> B) (as : Push A) : B =
  as _ (B -> B) (\a go acc => go (f acc a)) (\acc => acc) b

def sumPush = foldlPush 0 (+)
def productPush = foldlPush 1 (*)

def rangePush (n : Int) : Push Int =
  \k B f b =>
    let rec go c := if c < 1 then b else f c (go (c - 1));
    go n

def pushTest1 := sumPush (rangePush 100)
def pushTest2 := sumPush (mapPush (+ 1) (fromList myList))
