module Push

import Prelude (vtype, (&&), (||), (<), (+), (-), (*))
import List => L (List)

def Push A = (k : cv) (B : type k) -> (A -> B -> B) -> B -> B

def Nil {A : vtype} : Push A =
  \k B c n => n

def (::) {A : vtype} (hd : A) (tl : Push A) : Push A =
  \k B c n => c hd (tl k B c n)

def fromList {A : vtype} (as : List A) : Push A =
  \k B f b => L.foldr b f as

def toList {A : vtype} (as : Push A) : List A =
  as _ _ L.(::) L.Nil

def map {A B : vtype} (f : A -> B) (as : Push A) : Push B =
  \k R c n => as k R (\a bs => c (f a) bs) n

def foldr {A : vtype} {k} {B : type k} (b : B) (f : A -> B -> B) (as : Push A) : B =
  as k B f b

def foldl {A B : vtype} (b : B) (f : B -> A -> B) (as : Push A) : B =
  as _ (B -> B) (\a go acc => go (f acc a)) (\acc => acc) b

def sum = foldl 0 (+)
def product = foldl 1 (*)
def all = foldl True (&&)
def any = foldl False (||)

def range (n : Int) : Push Int =
  \k B f b =>
    let rec go c := if c < 1 then b else f c (go (c - 1));
    go n
