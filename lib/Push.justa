module Push

import Prelude (vtype, (&&), (||), (<), (+), (-), (*), Unit)
import IOUtil (return, seq)
import List => L (List)

pub def Push (A : vtype) = (k : cv) (B : type k) -> (A -> B -> B) -> B -> B

pub def Nil {A} : Push A =
  \k B c n => n

pub def (::) {A : vtype} (hd : A) (tl : Push A) : Push A =
  \k B c n => c hd (tl k B c n)

pub def fromList {A} (as : List A) : Push A =
  \k B f b => L.foldr b f as

pub def toList {A} (as : Push A) : List A =
  as _ _ L.(::) L.Nil

pub def map {A B : vtype} (f : A -> B) (as : Push A) : Push B =
  \k R c n => as k R (\a bs => c (f a) bs) n

pub def foldr {A : vtype} {k} {B : type k} (b : B) (f : A -> B -> B) (as : Push A) : B =
  as k B f b

pub def foldl {A B : vtype} (b : B) (f : B -> A -> B) (as : Push A) : B =
  as _ (B -> B) (\a go acc => go (f acc a)) (\acc => acc) b

pub def sum = foldl 0 (+)
pub def product = foldl 1 (*)
pub def all = foldl True (&&)
pub def any = foldl False (||)

pub def range (n : Int) : Push Int =
  \k B f b =>
    let rec go c := if c < 1 then b else f c (go (c - 1));
    go n

pub def foldIO_ {A : vtype} (f : A -> IO Unit) (as : Push A) : IO Unit =
  foldr (return []) (\hd tl => seq (f hd) tl) as
