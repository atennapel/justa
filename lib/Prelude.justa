module Prelude

def vtype = type val
def ctype = type comp

def id {A} (x : A) = x
def const {A B} (x y : A) = x

def not b = if b then False else True
def (&&) a b = if a then b else False
def (||) a b = if a then True else b

def cond {k} {A : type k} (a b : A) (c : Bool) : A =
  if c then a else b

def (<) a b = lt a b
def (+) a b = add a b
def (*) a b = mul a b
def (-) a b = sub a b

def factorial (n : Int) :=
  let rec go (n : Int) (acc : Int) :=
    if n < 2 then acc
    else go (n - 1) (acc * n);
  go n 1

data Void

def absurd {k} {A : type k} (v : Void) : A = match v {}

data Unit := U

data Option A := None | Some (value : A)

data Either A B := Left A | Right B

data Pair A B := MkPair (fst : A) (snd : B)

def fst {A B} (p : Pair A B) : A = p.fst
def snd {A B} (p : Pair A B) : B = p.snd
