module Prelude

pub def vtype = type val
pub def ctype = type comp

pub def id {A} (x : A) = x
pub def const {A B : meta} (x y : A) = x

pub def not b = if b then False else True
pub def (&&) a b = if a then b else False
pub def (||) a b = if a then True else b

pub def cond {k} {A : type k} (a b : A) (c : Bool) : A =
  if c then a else b

pub def (<) a b = lt a b
pub def (+) a b = add a b
pub def (*) a b = mul a b
pub def (-) a b = sub a b

pub def factorial (n : Int) :=
  let rec go (n : Int) (acc : Int) :=
    if n < 2 then acc
    else go (n - 1) (acc * n);
  go n 1

pub data Never : vtype

pub def absurd {k} {A : type k} (v : Never) : A = match v {}

pub def Unit : vtype = []
pub def U : Unit = []

pub data Option A := None | Some (value : A)

pub data Either A B := Left A | Right B

pub data (record) Pair A B := MkPair (fst : A) (snd : B)

pub def fst {A B} (p : Pair A B) : A = p.fst
pub def snd {A B} (p : Pair A B) : B = p.snd

pub data Monoid (A : vtype) : meta = MkMonoid (unit : A) (append : A -> A -> A)
pub def unit {A} {auto m : Monoid A} : A = m.unit
pub def append {A} {auto m : Monoid A} : A -> A -> A = m.append

pub auto def MonoidUnit : Monoid Unit = MkMonoid [] (\x y => [])

pub def appendOption {A} {auto m : Monoid A} (a b : Option A) : Option A =
  match a
  | None => b
  | Some x =>
    match b
    | None => a
    | Some y => Some (append x y)

pub auto def MonoidOption {A} {auto m : Monoid A} : Monoid (Option A) =
  MkMonoid None appendOption

-- strings
pub def Str = class "java.lang.String"

-- arrays
pub def arrayLength {A} (arr : Array A) : IO Int =
  unsafeIO "arraylength" arr

pub def arrayGet {A} (arr : Array A) (ix : Int) : IO A =
  unsafeIO "arrayload" arr ix

pub def arraySet {A} (arr : Array A) (ix : Int) (value : A) : IO Unit =
  let action : Void = unsafe "arraystore" arr ix value;
  unsafeIO "void" action []

-- JVM
pub def mainJVM (action : Array Str -> IO Unit) : Array Str -> Void =
  \args => unsafe "pop" (unsafeRunIO (action args))
