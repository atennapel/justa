module Prelude

def vtype = type val
def ctype = type comp

def id {A : meta} (x : A) = x
def const {A B : meta} (x y : A) = x

def not b = if b then False else True
def (&&) a b = if a then b else False
def (||) a b = if a then True else b

def (<) a b = lt a b
def (+) a b = add a b
def (*) a b = mul a b
def (-) a b = sub a b

def factorial (n : Int) :=
  let rec go (n : Int) (acc : Int) :=
    if n < 2 then acc
    else go (n - 1) (acc * n);
  go n 1

data Void

data Unit := U

data Option A := None | Some (value : A)

data Pair A B := MkPair (fst : A) (snd : B)

def fst {A B : vtype} (p : Pair A B) : A =
  match p | MkPair a b => a

def snd {A B : vtype} (p : Pair A B) : B =
  match p | MkPair a b => b
