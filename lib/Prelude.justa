module Prelude

pub def vtype = type val
pub def ctype = type comp

pub def id {A} (x : A) = x
pub def const {A B : meta} (x y : A) = x

pub def not b = if b then False else True
pub def (&&) a b = if a then b else False
pub def (||) a b = if a then True else b

pub def cond {k} {A : type k} (a b : A) (c : Bool) : A =
  if c then a else b

pub def (<) a b = lt a b
pub def (+) a b = add a b
pub def (*) a b = mul a b
pub def (-) a b = sub a b

pub def factorial (n : Int) :=
  let rec go (n : Int) (acc : Int) :=
    if n < 2 then acc
    else go (n - 1) (acc * n);
  go n 1

pub data Void : vtype

pub def absurd {k} {A : type k} (v : Void) : A = match v {}

pub data Unit := U

pub data Option A := None | Some (value : A)

pub data Either A B := Left A | Right B

pub data Pair A B := MkPair (fst : A) (snd : B)

pub def fst {A B} (p : Pair A B) : A = p.fst
pub def snd {A B} (p : Pair A B) : B = p.snd

pub data Monoid (A : vtype) : meta = MkMonoid (unit : A) (append : A -> A -> A)

pub auto def MonoidUnit : Monoid Unit = MkMonoid U (\x y => U)

pub def unit {A} {auto m : Monoid A} : A=
  match m
  | MkMonoid unit _ => unit

def test : Unit = unit {Unit}

pub def append {A} {auto m : Monoid A} : A -> A -> A =
  match m
  | MkMonoid _ append => append

pub def appendOption {A} {auto m : Monoid A} (a b : Option A) : Option A =
  match a
  | None => b
  | Some x =>
    match b
    | None => a
    | Some y => Some (append {A} x y)

pub auto def MonoidOption {A} {auto m : Monoid A} : Monoid (Option A) =
  MkMonoid None (appendOption {A})

def test2 = append {Option Unit} (Some U) (unit {Option Unit})
