module testing.MutualRec

pub def (<) a b = lt a b
pub def (-) a b = sub a b

def evenodd : CPair (Int -> Bool) (CPair (Int -> Bool) CUnit) :=
  let rec go : CPair (Int -> Bool) (CPair (Int -> Bool) CUnit) :=
    MkCPair
      (\n => if n < 1 then True else cfst (csnd go) (n - 1))
      (MkCPair
        (\n => if n < 1 then False else cfst go (n - 1))
        MkCUnit);
  go

def even = cfst evenodd
def odd = cfst (csnd evenodd)

def test := even 42
