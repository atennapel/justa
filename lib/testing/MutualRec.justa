module testing.MutualRec

pub def (<) a b = lt a b
pub def (-) a b = sub a b

def evenodd : [even : Int -> Bool, odd : Int -> Bool] :=
  let rec go : [even : Int -> Bool, odd : Int -> Bool] :=
    [
      \n => if n < 1 then True else go.odd (n - 1),
      \n => if n < 1 then False else go.even (n - 1)
    ];
  go

def even = evenodd.even
def odd = evenodd.odd

def test := even 42
