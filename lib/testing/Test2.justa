module testing.Test2

import testing.Test (test)

pub def (<) a b = lt a b
pub def (-) a b = sub a b

def lifttest : [[Bool, Bool], [Bool, Bool]] :=
  let f (x : Bool) := x;
  let g (y : Bool) : [Bool, Bool] := [f y, f y];
  [g True, g False]

def evenodd : [even : Int -> Bool, odd : Int -> Bool] :=
  let f (x : Bool) := x;
  let rec go : [even : Int -> Bool, odd : Int -> Bool] :=
    [
      \n => if n < 1 then True else f (go.odd (n - 1)),
      \n => if n < 1 then False else f (go.even (n - 1))
    ];
  go

def even := evenodd.even
