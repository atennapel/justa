module testing.IOTest

import Prelude (vtype, (+))
import IOUtil (return, bind, seq, map)

def doStuff := return 42

def ioTest1 : IO Int :=
  bind doStuff \x =>
  bind doStuff \y =>
  return (x + y)

def Str = class "java.lang.String"

def strtest (x : Str) := x

def str := "abcdefg"

def println (msg : Str) : IO [] :=
  let out : class "java.io.PrintStream" :=
    unsafe "getstatic:java.lang.System.out";
  let res : [] = [];
  unsafeIO "invokevirtualvoid:println" out res msg
