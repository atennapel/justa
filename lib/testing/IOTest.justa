module testing.IOTest

import Prelude (vtype, Unit, Str, (+), arrayLength, arrayGet, arraySet, mainJVM)
import IOUtil (return, bind, seq, map)

def doStuff := return 42

def ioTest1 : IO Int :=
  bind doStuff \x =>
  bind doStuff \y =>
  return (x + y)

def strtest (x : Str) := x

def str := "abcdefg"

def println (msg : Str) : IO Unit :=
  let out : class "java.io.PrintStream" :=
    unsafe "getstatic:java.lang.System.out";
  let action : Void = unsafe "invokevirtual:println" out msg;
  unsafeIO "void" action []

-- arrays
def arrayTest (a : Array Int) :=
  bind (arrayGet a 0) \x =>
  seq (arraySet a 0 (x + 1))
    (arrayLength a)

-- main method
def mainJusta (args : Array Str) : IO Unit =
  println "Hello, world!"

pub def main := mainJVM mainJusta

pub def main2 := mainJVM \args =>
  println "Hello, world!"

-- testing
data (record) IntPair := MkPair (fst : Int) (snd : Int)
def p := MkPair 1 2
def test := match p | MkPair a b => a

data (finite Int) Three := A | B | C
def a := C
def test2 :=
  match a
  | A => 0
  | C => 2
  | B => 42

data (finite Bool) VoidFin : vtype

def test3 (x : VoidFin) : Int := match x {}

data (wrapper) MyId := MkMyId Int
def id := MkMyId 42
def test4 := match id | MkMyId n => n
def test5 := id.0

