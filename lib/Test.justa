module Test

import Prelude (vtype, (+), Option, None, Some)
import List (List, Nil, (::), map => mapList)

data Functor (F : vtype -> vtype) = MkFunctor (map : {A B : vtype} -> (A -> B) -> F A -> F B)
def map {F} {auto fnc : Functor F} : {A B : vtype} (f : A -> B) (x : F A) -> F B = fnc.map

def mapOption {A B : vtype} (f : A -> B) (x : Option A) : Option B =
  match x
  | None => None
  | Some v => Some (f v)

auto def FunctorOption : Functor Option = MkFunctor mapOption
auto def FunctorList : Functor List = MkFunctor mapList

def list1 = 1 :: 2 :: 3 :: Nil
def list2 = Some 1 :: None :: Some 3 :: Nil
def listtest1 := map (\n => n + 1) list1
-- def listtest2 := map (\o => map (\n => n + 1) o) list2
