module Meta

pub data VoidM : meta

pub def absurdM {A} (v : VoidM) : A = match v {}

pub data UnitM = UM

pub def fix {A : meta} {B : A -> meta} (go : ((x : A) -> B x) -> (x : A) -> B x) (x : A) : B x =
  fixIx {UnitM} {\_ => A} {\_ x => B x} (\r {i} x => go (r {i}) x) {UM} x

pub data BoolM = TrueM | FalseM

pub def notM (b : BoolM) =
  match b
  | TrueM => FalseM
  | FalseM => TrueM

pub data NatM = ZM | SM NatM

pub def predM (n : NatM) =
  match n
  | ZM => ZM
  | SM n => n

pub def addM (a b : NatM) : NatM =
  fix {NatM} (\go a => match a
  | ZM => b
  | SM m => SM (go m)) a
