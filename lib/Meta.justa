module Meta

data VoidM : meta
data UnitM = UM
data BoolM = TrueM | FalseM

-- identity type
def (~) {A} (x y : A) = Id x y
def (!~) {A} (x y : A) = x ~ y -> VoidM

def idJ {A} (P : {a b : A} -> a ~ b -> meta) (h : {a} -> P {a} refl) {a b : A} (p : a ~ b) : P p =
  elimId (\{c} q => P {a} {c} q) h p

def rewrite {A} (P : A -> meta) {a b : A} (p : a ~ b) (x : P a) : P b =
  idJ (\{a} {b} _ => P a -> P b) (\q => q) p x

def cast {A B : meta} (p : A ~ B) (x : A) : B =
  rewrite (\y => y) p x

def sym {A} {a b : A} (p : a ~ b) : b ~ a =
  idJ (\{x} {y} _ => y ~ x) refl p

def trans {A} {a b c : A} (p : b ~ c) (q : a ~ b) : a ~ c =
  rewrite ((~) a) p q

def ap {A B} {a b : A} (f : A -> B) (p : a ~ b) : f a ~ f b =
  rewrite {A} (\x => f a ~ f x) {a} {b} p refl

def idRefl {A} {a : A} (p : a ~ a) : p ~ refl =
  elimId (\{c} q => Id q (refl {A} {c})) refl p

def idK {A} {a : A} (P : a ~ a -> meta) (p : a ~ a) (h : P refl) : P p =
  rewrite P (sym (idRefl p)) h

def uip {A} {a b : A} (p1 p2 : a ~ b) : p1 ~ p2 =
  (elimId (\{c} p => (q : a ~ c) -> q ~ p) idRefl p2) p1

def Singleton {A} (x : A) : meta = [value : A, proof : value ~ x]
def MkSingleton {A} (x : A) : Singleton x = [x, refl]

--
def So b = b ~ TrueM

data Nat = Z | S Nat

data Vec (n : Nat) A
  | VNil (proof : Z ~ n)
  | VCons {m} (head : A) (tail : Vec m A) (proof : S m ~ n)

def vnil {A} : Vec Z A = VNil refl
def vcons {m A} (head : A) (tail : Vec m A) : Vec (S m) A =
  VCons head tail refl
